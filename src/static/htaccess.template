# Mastercraft Engineers: Apache configuration for the static build (works on typical PHP/WordPress shared hosting)
# Requires mod_rewrite, mod_headers, mod_deflate, mod_expires (standard on cPanel/Plesk hosts).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- HTTPS and one canonical host (non-www) ---
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://mastercraftengineers.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.mastercraftengineers\.com$ [NC]
RewriteRule ^ https://mastercraftengineers.com%{REQUEST_URI} [R=301,L]

# --- Legacy WordPress URLs (only relevant once WordPress is replaced by this build) ---
# Old uploaded photographs -> optimised equivalents (preserves image-search URLs)
{{IMAGE_REDIRECTS}}
# Old logo
RewriteRule ^wp/wp-content/uploads/\d{4}/\d{2}/mastercraft_logo\.png$ /assets/img/mastercraft-logo.png [R=301,L,NC]
# Feeds, XML-RPC and admin paths no longer exist
RewriteRule ^(comments/)?feed/?$ - [G,L]
RewriteRule ^wp/(wp-admin|wp-includes|xmlrpc\.php|wp-json).* - [G,L]
RewriteRule ^wp-json/.* - [G,L]
# Old URL variants -> canonical
RewriteRule ^index\.(php|html)$ / [R=301,L]
RewriteRule ^(contact|facilities|components|2k-parts|injection-moulds|large-size-injection-moulds)$ /$1/ [R=301,L]

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/ld+json image/svg+xml text/plain application/xml
</IfModule>

# --- Caching (assets are cache-busted with ?v=<build date>; images/fonts are content-named) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
AddType image/avif .avif
AddType font/woff2 .woff2

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Enable once HTTPS is confirmed for the whole domain:
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<Files "contact.php">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store"
  </IfModule>
</Files>
